<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/Controls.xaml"/></ResourceDictionary.MergedDictionaries>

  <DataTemplate x:Key="SkinsView">
    <DockPanel TextElement.Foreground="{DynamicResource Ink}">
      <DockPanel DockPanel.Dock="Top" Margin="4,2,4,12">
        <TextBlock Text="{DynamicResource L_Skins}" FontSize="25" FontWeight="Bold"/>
      </DockPanel>
      <TabControl Style="{StaticResource WorkspaceTabs}" SelectedIndex="{Binding SkinSection}">
        <TabItem Header="{DynamicResource L_SkinLibrary}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Background="{DynamicResource Soft}"
                      Margin="0,0,14,0" VerticalAlignment="Top" Padding="14">
                <StackPanel>
                  <Border Background="{DynamicResource Hero}" CornerRadius="11" Height="222" Padding="15">
                    <Grid>
                      <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="52" Foreground="#DDD5FF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                          <DataTrigger Binding="{Binding HasLocalSkin}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <Ellipse Width="96" Height="13" Fill="#30000000" VerticalAlignment="Bottom"/>
                      <Image Source="{Binding LocalSkinBody}" Width="105" Height="178" Stretch="Uniform"
                             RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding AccountLabel}" FontSize="20" FontWeight="Bold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SkinState}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <Button Content="{DynamicResource L_UseDefaultSkin}" Command="{Binding ClearSkin}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="1">
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Content="{DynamicResource L_ImportSkin}" Command="{Binding ImportSkin}"
                          Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                  <TextBlock Text="{DynamicResource L_SavedSkins}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource L_SkinLocalUsage}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="{DynamicResource L_AddAccount}" Command="{Binding OpenAccounts}" HorizontalAlignment="Left">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasAccount}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style></Button.Style>
                </Button>
                <ItemsControl ItemsSource="{Binding SkinTiles}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Width="128" Margin="0,0,8,8" Padding="6" CommandParameter="{Binding}"
                            Command="{Binding DataContext.SelectSkin, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            AutomationProperties.Name="{Binding Skin.Name}" ToolTip="{Binding Skin.Name}">
                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers><DataTrigger Binding="{Binding Active}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                          <Setter Property="Background" Value="{DynamicResource Soft}"/>
                        </DataTrigger></Style.Triggers>
                      </Style></Button.Style>
                      <StackPanel Width="112">
                        <Grid Height="112">
                          <Border Background="{DynamicResource InputSurface}" CornerRadius="7"/>
                          <Image Source="{Binding Preview}" Margin="13,8" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                          <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/check-24.png" Width="18" Height="18" Margin="4"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding Active, Converter={StaticResource BoolVisibility}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Skin.Name}" TextTrimming="CharacterEllipsis" Margin="2,6,2,1"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource L_SkinSync}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource Soft}" CornerRadius="14" Padding="18" MaxWidth="620" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Text="CustomSkinLoader" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource L_SkinSyncIntro}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/>
                <TextBlock Text="{DynamicResource L_SkinTarget}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Instances}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedInstance}"
                          AutomationProperties.Name="{DynamicResource L_SkinTarget}" HorizontalAlignment="Left" MinWidth="175" MaxWidth="340"/>
                <WrapPanel Margin="0,4,0,4">
                  <Button Content="{DynamicResource L_ApplySkin}" Command="{Binding ApplySkin}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="{DynamicResource L_RemoveAppliedSkin}" Command="{Binding RemoveAppliedSkin}"
                          Visibility="{Binding HasAppliedSkin, Converter={StaticResource BoolVisibility}}"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource L_SkinApplied}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"
                           Visibility="{Binding HasAppliedSkin, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6"/>
                <TextBlock Text="{DynamicResource L_SkinScope}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DataTemplate>

  <DataTemplate x:Key="ScreenshotsView">
    <DockPanel TextElement.Foreground="{DynamicResource Ink}">
      <DockPanel DockPanel.Dock="Top" Margin="4,2,4,12">
        <Button DockPanel.Dock="Right" Content="{DynamicResource L_OpenFolder}" Command="{Binding OpenScreenshots}"/>
        <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding Instances}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedInstance}" AutomationProperties.Name="{DynamicResource L_ActiveInstance}"/>
        <TextBlock Text="{DynamicResource L_Screenshots}" FontSize="25" FontWeight="Bold"/>
      </DockPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="{DynamicResource L_NoScreens}" Foreground="{DynamicResource Muted}" Margin="4">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Screenshots.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Screenshots}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Command="{Binding DataContext.OpenScreenshot, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Margin="0,0,9,9" Padding="6">
                <StackPanel Width="205">
                  <Image Source="{Binding Thumbnail}" Width="205" Height="116" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="1,4,0,0"/>
                </StackPanel>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>
