<Window x:Class="Launcher.UI.RemoveContentDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource L_Remove}" Width="460" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}"
 Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Border DockPanel.Dock="Left" Background="{DynamicResource DangerSurface}" Width="35" Height="35" CornerRadius="8" Margin="0,0,10,0">
          <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/delete-24.png" Width="20" Height="20"/>
        </Border>
        <TextBlock Text="{DynamicResource L_RemoveContentTitle}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,13,0,12">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource DangerText}" Margin="0,7,0,0"/>
      </StackPanel>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="{DynamicResource L_Cancel}" IsCancel="True" IsDefault="True" Style="{DynamicResource SecondaryPixelButton}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource L_Remove}" Click="ConfirmRemoval" Style="{DynamicResource DangerButton}" Margin="0"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
