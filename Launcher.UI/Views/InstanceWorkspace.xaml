<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../Styles/Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="WorkspaceTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Pill" Background="Transparent" Padding="12,6" Margin="0,0,4,0" CornerRadius="7">
        <ContentPresenter ContentSource="Header"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource InputSurface}"/></Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Primary}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="WorkspaceFolderTemplate">
    <DockPanel Margin="4,2">
      <Button DockPanel.Dock="Right" Content="{DynamicResource L_OpenFolder}"
              Command="{Binding DataContext.OpenWorkspaceFolder, RelativeSource={RelativeSource AncestorType=ListBox}}"
              CommandParameter="{Binding}" Style="{StaticResource SecondaryPixelButton}" Margin="8,0,0,0"/>
      <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE838;"
                 Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </DataTemplate>
  <DataTemplate x:Key="InstanceWorkspaceView">
    <Grid TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="{DynamicResource L_Play}" Command="{Binding Launch}" Style="{StaticResource PrimaryButton}"/>
          <Button Command="{Binding OpenInstanceSettings}" ToolTip="{DynamicResource L_InstanceSettings}"
                  AutomationProperties.Name="{DynamicResource L_InstanceSettings}" Style="{StaticResource SecondaryPixelButton}">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;"/>
          </Button>
        </WrapPanel>
        <Button DockPanel.Dock="Left" Command="{Binding BackToInstances}" ToolTip="{DynamicResource L_Instances}"
                AutomationProperties.Name="{DynamicResource L_Instances}" VerticalAlignment="Center">
          <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/previous-24.png" Width="16" Height="16"/>
        </Button>
        <Border DockPanel.Dock="Left" Background="{DynamicResource Soft}" Width="58" Height="58" CornerRadius="8" Margin="0,0,11,0">
          <Grid ClipToBounds="True">
            <Image Source="/Launcher.UI;component/Assets/instance-cover.png" Stretch="UniformToFill"/>
            <Image Source="{Binding WorkspaceCover}" Stretch="UniformToFill"/>
          </Grid>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <WrapPanel TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="12" Margin="0,2,0,0">
            <TextBlock Text="{Binding ActiveMetadata}" Margin="0,0,9,0"/>
            <TextBlock Text="{Binding WorkspacePlayTime}" Margin="0,0,9,0"/>
            <TextBlock Text="{Binding WorkspaceLastPlayed}"/>
          </WrapPanel>
        </StackPanel>
      </DockPanel>
      <TabControl Grid.Row="1" SelectedIndex="{Binding WorkspacePage}" ItemContainerStyle="{StaticResource WorkspaceTab}">
        <TabControl.Template><ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource Soft}" CornerRadius="9" Padding="4"
                    HorizontalAlignment="Left" Margin="0,0,0,9">
              <TabPanel IsItemsHost="True"/>
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate></TabControl.Template>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/catalog-24.png" Width="15" Height="15" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource L_InstanceContent}"/></StackPanel></TabItem.Header>
          <Grid TextElement.Foreground="{DynamicResource Ink}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
              <WrapPanel DockPanel.Dock="Right" MaxWidth="470">
                <Button Content="{DynamicResource L_AddFiles}" Command="{Binding AddWorkspaceFiles}" Style="{StaticResource SecondaryPixelButton}"/>
                <Button Content="{DynamicResource L_FindProjects}" Command="{Binding FindWorkspaceContent}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="{DynamicResource L_Reload}" Command="{Binding ReloadWorkspace}"/>
              </WrapPanel>
              <Grid MinWidth="105" Margin="0,0,6,0">
                <TextBox x:Name="WorkspaceSearch" Text="{Binding ContentQuery, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5"
                         AutomationProperties.Name="{DynamicResource L_SearchHint}"/>
                <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/search-24.png" IsHitTestVisible="False"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,11,0,0" Width="16" Height="16"/>
                <TextBlock Text="{DynamicResource L_SearchInstanceContent}" Foreground="{DynamicResource Muted}"
                           Margin="30,10,16,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=WorkspaceSearch}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,4,4">
              <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ContentKinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectedValue="{Binding ContentKind}" Width="150" AutomationProperties.Name="{DynamicResource L_ProjectType}"/>
              <TextBlock Text="{Binding WorkspaceContent.Count, StringFormat={}{0}}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </DockPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="4">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Background="{DynamicResource Soft}" Margin="0,0,0,3" TextElement.Foreground="{DynamicResource Muted}"
                      TextElement.FontWeight="SemiBold">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource L_InstalledProject}" Margin="12,6,0,6"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource L_InstalledVersion}" Margin="8,6,0,6"/>
                  <TextBlock Grid.Column="2" Text="{DynamicResource L_RowActions}" HorizontalAlignment="Center" Margin="0,6"/>
                </Grid>
                <Grid>
                  <ListBox ItemsSource="{Binding WorkspaceContent}" Background="Transparent" BorderThickness="0" Padding="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                      <Border Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="134"/></Grid.ColumnDefinitions>
                          <DockPanel Margin="8,0,8,0">
                            <Image DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,8,0" Stretch="Uniform">
                              <Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{Binding Icon}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                  <Setter Property="Source" Value="/Launcher.UI;component/Assets/UI-v2/Icons/catalog-24.png"/>
                                  <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
                                </DataTrigger></Style.Triggers>
                              </Style></Image.Style>
                            </Image>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                              <TextBlock Foreground="{DynamicResource Muted}" FontSize="11">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                  <Setter Property="Text" Value="{DynamicResource L_Mods}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="resourcepacks"><Setter Property="Text" Value="{DynamicResource L_ResourcePacks}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="shaderpacks"><Setter Property="Text" Value="{DynamicResource L_Shaders}"/></DataTrigger>
                                  </Style.Triggers>
                                </Style></TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </DockPanel>
                          <StackPanel Grid.Column="1" Margin="6,0,7,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.ViewWorkspaceProject, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="{DynamicResource L_OpenProject}"
                                    AutomationProperties.Name="{DynamicResource L_OpenProject}" Padding="5" MinHeight="28" Margin="0,0,5,0">
                              <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/external-24.png" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding DataContext.ToggleContent, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{DynamicResource L_ToggleContent}" Padding="5" MinHeight="28" Margin="0,0,5,0">
                              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{DynamicResource L_DisabledContent}"/>
                                <Setter Property="Background" Value="{DynamicResource Soft}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True">
                                  <Setter Property="Content" Value="{DynamicResource L_EnabledContent}"/>
                                  <Setter Property="Background" Value="{DynamicResource Primary}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </DataTrigger></Style.Triggers>
                              </Style></Button.Style>
                            </Button>
                            <Button Command="{Binding DataContext.DeleteContent, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                    ToolTip="{DynamicResource L_Remove}" AutomationProperties.Name="{DynamicResource L_Remove}"
                                    Padding="5" MinHeight="28" Margin="0">
                              <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/delete-24.png" Width="16" Height="16"/>
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{DynamicResource L_EmptyContent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource Muted}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding WorkspaceContent.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource L_InstanceFiles}">
          <ListBox ItemsSource="{Binding WorkspaceFolders}" ItemTemplate="{StaticResource WorkspaceFolderTemplate}"/>
        </TabItem>
        <TabItem Header="{DynamicResource L_InstanceWorlds}">
          <Grid>
            <ListBox ItemsSource="{Binding WorkspaceWorlds}" ItemTemplate="{StaticResource WorkspaceFolderTemplate}"/>
            <TextBlock Text="{DynamicResource L_NoWorlds}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource Muted}">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding WorkspaceWorlds.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource L_Logs}">
          <DockPanel>
            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="{DynamicResource L_Reload}" Command="{Binding ReloadWorkspace}"/>
            <TextBox Text="{Binding WorkspaceLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="{DynamicResource L_Settings}">
          <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource InstancePreferencesView}" TextElement.Foreground="{DynamicResource Ink}"/>
        </TabItem>
      </TabControl>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
