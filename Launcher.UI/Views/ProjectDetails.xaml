<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Launcher.UI">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="ProjectDetailsView">
    <Grid TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Left" Content="{DynamicResource L_BackToCatalog}" Command="{Binding CloseProject}"
                  Style="{StaticResource SecondaryPixelButton}"/>
          <Button DockPanel.Dock="Right" Content="Modrinth ↗" Command="{Binding OpenProjectSite}"/>
        </DockPanel>
        <Border Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11"
                Padding="14" Margin="0,0,0,10">
          <DockPanel>
            <Border DockPanel.Dock="Left" Background="{DynamicResource InputSurface}" Width="62" Height="62" CornerRadius="8" Margin="0,0,14,0">
              <Image Stretch="Uniform">
                <Image.Style><Style TargetType="Image">
                  <Setter Property="Source" Value="{Binding Details.Icon}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Details.Icon}" Value="{x:Null}">
                    <Setter Property="Source" Value="/Launcher.UI;component/Assets/UI-v2/Icons/catalog-48.png"/>
                    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
                  </DataTrigger></Style.Triggers>
                </Style></Image.Style>
              </Image>
            </Border>
            <StackPanel>
              <TextBlock Text="{Binding Details.Title}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <WrapPanel TextElement.Foreground="{DynamicResource Muted}">
                <TextBlock Text="{Binding ProjectAuthor}" Margin="0,0,10,0"/>
                <Image Source="/Launcher.UI;component/Assets/UI-v2/Icons/download-24.png" Width="14" Height="14" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Details.Downloads, StringFormat=N0}"/>
              </WrapPanel>
              <TextBlock Text="{Binding Details.Description}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
      <TabControl Grid.Row="1">
        <TabControl.Template><ControlTemplate TargetType="TabControl">
          <DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True"/>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,4,0,0"/>
          </DockPanel>
        </ControlTemplate></TabControl.Template>
        <TabItem Header="{DynamicResource L_ProjectOverview}">
          <ui:ProjectDescription Markdown="{Binding Details.Body}" Foreground="{DynamicResource Ink}" Background="{DynamicResource Surface}"
                                 VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
        </TabItem>
        <TabItem Header="{DynamicResource L_ProjectVersions}">
          <Grid TextElement.Foreground="{DynamicResource Ink}" Margin="0,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" Margin="0,0,10,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><StackPanel>
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ui:ProjectDescription Grid.Column="1" Markdown="{Binding Version.Changelog}" Foreground="{DynamicResource Ink}"
                                   VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Background="{DynamicResource Surface}"/>
          </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource L_ProjectGallery}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource Ink}">
            <Grid>
              <ItemsControl ItemsSource="{Binding Details.Gallery}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Command="{Binding DataContext.OpenProjectImage, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" Padding="3" Margin="0,0,10,10"
                          AutomationProperties.Name="{DynamicResource L_OpenGalleryImage}" ToolTip="{DynamicResource L_OpenGalleryImage}">
                    <StackPanel Width="300">
                      <Image Source="{Binding Image}" Height="168" Stretch="Uniform"/>
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="4" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource L_NoProjectImages}" Foreground="{DynamicResource Muted}" Margin="8">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Details.Gallery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding Details.Gallery.Length}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" Background="{DynamicResource Soft}" CornerRadius="9" Padding="8,5,8,2" Margin="0,8,0,0">
        <WrapPanel>
          <TextBlock Text="{DynamicResource L_ProjectVersions}" Margin="0,0,6,7" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" DisplayMemberPath="Number" Width="120"
                    AutomationProperties.Name="{DynamicResource L_ProjectVersions}"/>
          <TextBlock Text="{DynamicResource L_TargetInstance}" Margin="2,0,6,7" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" DisplayMemberPath="Name" Width="156"
                    AutomationProperties.Name="{DynamicResource L_TargetInstance}"/>
          <Button Content="{DynamicResource L_Install}" Command="{Binding Install}" Style="{StaticResource PrimaryButton}"/>
          <TextBlock Text="{DynamicResource L_ProjectVersionMismatch}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                     Margin="0,0,4,7" VerticalAlignment="Center"
                     Visibility="{Binding ShowVersionMismatch, Converter={StaticResource BoolVisibility}}"/>
        </WrapPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
