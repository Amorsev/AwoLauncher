<Window x:Class="Launcher.UI.ActionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="490" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource DialogSurface}"
 Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20">
    <StackPanel>
      <DockPanel>
        <Border x:Name="Badge" DockPanel.Dock="Left" Background="{DynamicResource Soft}" Width="34" Height="34"
                CornerRadius="8" Margin="0,0,10,0">
          <TextBlock x:Name="Glyph" Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="17"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="19"
                   FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
      <ScrollViewer MaxHeight="165" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock x:Name="Message" TextWrapping="Wrap"/>
          <TextBlock x:Name="Warning" TextWrapping="Wrap" Foreground="{DynamicResource DangerText}" Margin="0,8,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <ContentControl x:Name="Details" Margin="0,10,0,0" HorizontalContentAlignment="Stretch"/>
      <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="CancelButton" Content="{DynamicResource L_Cancel}" IsCancel="True" IsDefault="True" Margin="0,0,8,0"/>
        <Button x:Name="SecondaryButton" Click="ChooseSecondary" Margin="0,0,8,0"/>
        <Button x:Name="PrimaryButton" Click="ChoosePrimary" Style="{DynamicResource PrimaryButton}" Margin="0"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
